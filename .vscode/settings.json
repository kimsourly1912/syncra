{
  "files.associations": {
    "*.css": "tailwindcss"
  },
  "editor.quickSuggestions": {
    "strings": "on"
  },
  // Auto fix
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
  },
  "tailwindCSS.classAttributes": [
    "class",
    "ui"
  ],
  "tailwindCSS.classFunctions": [
    "defineAppConfig"
  ],
  "eslint.useFlatConfig": true,
  // Each app has its own eslint.config.mjs (and Admin's needs its tsconfig): lint a file with the
  // config of the app it's in, as the commit hook does.
  "eslint.workingDirectories": [{ "mode": "auto" }],
  // LF, as .gitattributes stores every file.
  "files.eol": "\n",
  // autocomplete on function (tw)
  "tailwindCSS.experimental.classRegex": [
    "tw`(.*?)`",
    "tw\\('(.*?)'\\)",
    "tw\\(\\s*('(.*?)'|\"(.*?)\")\\s*\\)",
  ],
  "i18n-ally.localesPaths": [
    "src/portal/i18n",
    "src/web/i18n",
    "src/portal/i18n/locales",
    "src/web/i18n/locales"
  ]
}